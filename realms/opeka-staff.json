{
  "realm": "opeka-staff",
  "displayName": "ΟΠΕΚΑ — Προσωπικό",
  "enabled": true,
  "internationalizationEnabled": true,
  "defaultLocale": "el",
  "supportedLocales": [
    "el",
    "en"
  ],
  "eventsEnabled": true,
  "eventsExpiration": 31536000,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "IDENTITY_PROVIDER_LOGIN",
    "IDENTITY_PROVIDER_LOGIN_ERROR",
    "IDENTITY_PROVIDER_FIRST_LOGIN",
    "IDENTITY_PROVIDER_FIRST_LOGIN_ERROR",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR"
  ],
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "resetPasswordAllowed": false,
  "duplicateEmailsAllowed": true,
  "editUsernameAllowed": false,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"validations\": {\"length\": {\"min\": 1, \"max\": 255}}}, {\"name\": \"email\", \"displayName\": \"${email}\", \"multivalued\": false, \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"validations\": {\"length\": {\"max\": 255}}}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"validations\": {\"length\": {\"max\": 255}}}, {\"name\": \"afm\", \"displayName\": \"ΑΦΜ\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"validations\": {\"pattern\": {\"pattern\": \"^[0-9]{9}$\", \"error-message\": \"Μη έγκυρο ΑΦΜ\"}}}, {\"name\": \"fatherName\", \"displayName\": \"Πατρώνυμο\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"motherName\", \"displayName\": \"Μητρώνυμο\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"birthYear\", \"displayName\": \"Έτος γέννησης\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "sslRequired": "external",
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(8) and notUsername and notEmail",
  "roles": {
    "realm": [
      {
        "name": "OPEKA_LAE",
        "description": "Πρόσβαση στη ΛΑΕ / Μητρώο"
      },
      {
        "name": "OPEKA_DOCUMENTS",
        "description": "Πρόσβαση στο Πρωτόκολλο & DMS"
      },
      {
        "name": "OPEKA_DEBTORS",
        "description": "Πρόσβαση στο Μητρώο Οφειλετών"
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "gsis-govuser-test",
      "providerId": "gsis-govuser-test",
      "displayName": "Δημόσια Διοίκηση (πιλοτικό)",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "local-mock-client",
        "clientSecret": "local-mock-secret",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "read",
        "syncMode": "FORCE"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "afm",
      "identityProviderAlias": "gsis-govuser-test",
      "identityProviderMapper": "gsis-user-attribute-mapper",
      "config": {
        "syncMode": "INHERIT",
        "jsonField": "taxid",
        "userAttribute": "afm"
      }
    },
    {
      "name": "fatherName",
      "identityProviderAlias": "gsis-govuser-test",
      "identityProviderMapper": "gsis-user-attribute-mapper",
      "config": {
        "syncMode": "INHERIT",
        "jsonField": "fathername",
        "userAttribute": "fatherName"
      }
    },
    {
      "name": "motherName",
      "identityProviderAlias": "gsis-govuser-test",
      "identityProviderMapper": "gsis-user-attribute-mapper",
      "config": {
        "syncMode": "INHERIT",
        "jsonField": "mothername",
        "userAttribute": "motherName"
      }
    },
    {
      "name": "birthYear",
      "identityProviderAlias": "gsis-govuser-test",
      "identityProviderMapper": "gsis-user-attribute-mapper",
      "config": {
        "syncMode": "INHERIT",
        "jsonField": "birthyear",
        "userAttribute": "birthYear"
      }
    }
  ],
  "clients": [
    {
      "clientId": "opeka-landpage",
      "name": "ΟΠΕΚΑ Κεντρική πύλη (προσωπικό)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-landpage-staff-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8082/login/oauth2/code/public-admin"
      ],
      "webOrigins": [
        "http://localhost:8082"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8082/*"
      },
      "protocolMappers": [
        {
          "name": "afm",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "afm",
            "claim.name": "afm",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "opeka-debtors",
      "name": "Μητρώο Οφειλετών",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-debtors-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "opeka-debtors",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "afm",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "afm",
            "claim.name": "afm",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
